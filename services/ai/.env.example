# Copy to services/ai/.env for local runs. Never commit the real file.
# live = real model (vLLM on OpenShift AI); stub = scripted agent for local development only.
LLM_MODE=live
# In the cluster:
LLM_BASE_URL=http://vero-llm-predictor.autonomous-cfo.svc.cluster.local:8080/v1
# From a laptop (oc port-forward -n autonomous-cfo pod/<vero-llm-predictor-pod> 8080:8080):
# LLM_BASE_URL=http://localhost:8080/v1
LLM_MODEL=vero-llm
LLM_API_KEY=not-needed
API_INTERNAL_URL=http://api:8080/internal/v1
INTERNAL_TOKEN=change-me
